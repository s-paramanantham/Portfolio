{
  "sd-document-validator": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/scripts/generate-sd.js --verify",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
